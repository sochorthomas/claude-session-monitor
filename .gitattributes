# Normalize to LF in the repository; check out with the platform's endings.
* text=auto

# Windows-only launchers: CRLF in the working tree. WScript in particular is
# happier with CRLF, and these are never run on anything but Windows.
*.ps1 text eol=crlf
*.vbs text eol=crlf
*.cmd text eol=crlf

*.py text eol=lf
*.pyw text eol=lf
*.md text eol=lf

*.png binary
